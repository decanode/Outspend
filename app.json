{
  "expo": {
    "name": "Outspend",
    "slug": "outspend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d1b2a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.decanode.outspend",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "com.android.vending.BILLING"
      ]
    },
    "plugins": [
      "expo-background-task",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Outspend uses the microphone so you can log expenses by voice.",
          "speechRecognitionPermission": "Outspend uses speech recognition to turn what you say into an expense."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-secure-store"
    ]
  }
}
